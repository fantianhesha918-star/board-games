rules_version = '2';

// ボードゲームアプリ オンライン対戦 Firestore セキュリティルール
// 方針: 匿名認証のみ・個人情報なし。部屋番号(ドキュメントID)を知っている人だけが
// get でき、一覧(list)は誰にも許可しない。
//
// 部屋には2スキーマある:
//   A) 2人用（othello）  … host / guest / hostSeen / guestSeen
//        state.turn   : "b"|"w"（ホスト=黒/ゲスト=白）
//        state.winner : "b"|"w"|"draw"（未決着 null）
//   B) 複数人用（memory 等）… host / cap / cpu / seats[] / seen{uid:ts}
//        state.turn   : 0..(cap+cpu-1)（席番号。0..cap-1=人間 seats[i]、以降=CPU）
//        state.seq    : 単調増加の整数（stale な上書きを弾く）
//        state.over   : 全員終了フラグ
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {

      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function d() { return resource.data; }          // 変更前
      function n() { return request.resource.data; }  // 変更後
      function changed() { return n().diff(d()).affectedKeys(); }

      function coreUnchanged() {
        return n().game == d().game
          && n().host.uid == d().host.uid
          && n().createdAt == d().createdAt;
      }

      allow get: if signedIn();
      allow list: if false;

      // ---------- 作成 ----------
      // seats フィールドの有無でスキーマを判別（memory 等 = 複数人 / othello = 2人）
      allow create: if signedIn() && code.matches("[0-9]{4}") && (
        (("seats" in n()) && createMulti()) || (!("seats" in n()) && createDuo())
      );
      function createDuo() {
        return n().host.uid == uid()
          && n().status == "waiting"
          && n().guest == null
          && n().game is string;
      }
      function createMulti() {
        return n().host.uid == uid()
          && n().status == "waiting"
          && n().game is string
          && n().cap is int && n().cap >= 2 && n().cap <= 4
          && n().cpu is int && n().cpu >= 0 && n().cpu <= 2
          && n().seats.size() == 1
          && n().seats[0].uid == uid();
      }

      // ---------- 更新 ----------
      allow update: if signedIn() && coreUnchanged() && (
        (("seats" in d()) && multiUpdate())
        || (!("seats" in d()) && duoUpdate())
      );

      /* ===== A) 2人用（othello） ===== */
      function isPlayerUid(u) {
        return u == d().host.uid || (d().guest != null && u == d().guest.uid);
      }
      function duoUpdate() { return isJoinDuo() || isHeartbeatDuo() || isMoveDuo(); }

      function isJoinDuo() {
        return d().status == "waiting"
          && d().guest == null
          && n().status == "playing"
          && n().guest.uid == uid()
          && n().guest.name is string
          && changed().hasOnly(["guest", "status", "guestSeen", "updatedAt"]);
      }
      function isHeartbeatDuo() {
        return (changed().hasOnly(["hostSeen"]) && uid() == d().host.uid)
          || (changed().hasOnly(["guestSeen"]) && d().guest != null && uid() == d().guest.uid);
      }
      function myTurnTag() { return uid() == d().host.uid ? "b" : "w"; }
      function oppWinTag() { return uid() == d().host.uid ? "w" : "b"; }
      function isMoveDuo() {
        return d().status == "playing"
          && isPlayerUid(uid())
          && n().guest.uid == d().guest.uid
          && changed().hasOnly(["state", "status", "updatedAt", "hostSeen", "guestSeen"])
          && (
            d().state.turn == myTurnTag()
            || (d().state.winner == null && n().state.winner == oppWinTag())
          );
      }

      /* ===== B) 複数人用（memory 等） ===== */
      function iAmSeated() {
        return d().seats.size() >= 1 && (
          d().seats[0].uid == uid()
          || (d().seats.size() > 1 && d().seats[1].uid == uid())
          || (d().seats.size() > 2 && d().seats[2].uid == uid())
          || (d().seats.size() > 3 && d().seats[3].uid == uid())
        );
      }
      function multiUpdate() { return isJoinMulti() || isHeartbeatMulti() || isMoveMulti(); }

      function seatsUnchanged() {
        return n().seats.size() == d().seats.size()
          && n().seats[0].uid == d().seats[0].uid
          && (d().seats.size() < 2 || n().seats[1].uid == d().seats[1].uid)
          && (d().seats.size() < 3 || n().seats[2].uid == d().seats[2].uid)
          && (d().seats.size() < 4 || n().seats[3].uid == d().seats[3].uid);
      }

      function isJoinMulti() {
        return d().status == "waiting"
          && d().seats.size() < d().cap
          && n().seats.size() == d().seats.size() + 1
          && n().seats[d().seats.size()].uid == uid()
          && n().seats[d().seats.size()].name is string
          && n().seats[0].uid == d().seats[0].uid
          && n().cap == d().cap && n().cpu == d().cpu
          && n().status == (n().seats.size() == d().cap ? "playing" : "waiting")
          && changed().hasOnly(["seats", "status", "seen", "updatedAt"]);
      }
      function isHeartbeatMulti() {
        return changed().hasOnly(["seen", "updatedAt"]) && iAmSeated();
      }
      // 対戦中の state 更新: 席についている本人なら可。席・cap・cpu は不変、
      // seq は単調増加（古い/重複の上書きを弾く）。手番の厳密判定はクライアント側。
      function isMoveMulti() {
        return d().status == "playing"
          && iAmSeated()
          && seatsUnchanged()
          && n().cap == d().cap && n().cpu == d().cpu
          && changed().hasOnly(["state", "seen", "updatedAt"])
          && n().state.seq is int
          && n().state.seq > d().state.seq;
      }

      // ---------- 削除 ----------
      allow delete: if signedIn() && (
        (("seats" in d()) && d().seats.size() >= 1 && uid() == d().seats[0].uid)
        || (!("seats" in d()) && uid() == d().host.uid)
      );
    }
  }
}
